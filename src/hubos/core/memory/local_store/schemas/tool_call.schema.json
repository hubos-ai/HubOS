{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HubOS Memory Tool Call",
  "version": "1.0",
  "type": "object",
  "required": ["call_id", "message_id", "tool_name", "arguments", "result", "timestamp"],
  "properties": {
    "call_id": {"type": "string", "pattern": "^call_"},
    "message_id": {"type": "string", "pattern": "^msg_"},
    "tool_name": {"type": "string"},
    "arguments": {"type": "object"},
    "result": {
      "type": "object",
      "properties": {
        "status": {"type": "string"},
        "output": {"type": "string"},
        "error": {"type": ["string", "null"]}
      }
    },
    "duration_ms": {"type": "integer"},
    "timestamp": {"type": "string", "format": "date-time"}
  }
}
